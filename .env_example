DATABASE_URL=postgresql://postgres:password@localhost:5432/banking_db
BANK_MAX_CLIENTS=50
BANK_ROLE=primary
BANK_NODE_ID=server-a
BANK_HOST=0.0.0.0
BANK_PORT=8000
# Configure on Server A:
# BANK_PEER_URL=http://SERVER_B_IP:8000
# Configure on Server B instead:
# BANK_PRIMARY_URL=http://SERVER_A_IP:8000
# Set the same witness database and cluster ID on both servers:
# BANK_WITNESS_DATABASE_URL=postgresql://WITNESS_HOST:5432/banking_witness
# BANK_CLUSTER_ID=mini-banking-lab
# Tests use a separate, disposable PostgreSQL database:
# BANK_TEST_DATABASE_URL=postgresql://test_user:change-me@127.0.0.1:5432/banking_test